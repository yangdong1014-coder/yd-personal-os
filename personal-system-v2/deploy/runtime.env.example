# Descriptor-bound runtime file. Install outside the code tree as root:psy 0640;
# never install this secret-bearing file as mode 0644. Its root-owned parent must
# let psy traverse/read but not write. The launcher never evaluates it as shell.
PERSONAL_OS_ENV=production
PERSONAL_OS_REMOTE=1
PERSONAL_OS_BIND_HOST=127.0.0.1
PERSONAL_OS_TRUSTED_HOSTS=psy.example.com
PERSONAL_OS_TRUSTED_PROXY=127.0.0.1
PERSONAL_OS_PROXY_TOKEN=replace_with_a_distinct_csprng_token_of_at_least_32_bytes
SECRET_KEY=replace_with_a_csprng_secret_of_at_least_32_bytes
