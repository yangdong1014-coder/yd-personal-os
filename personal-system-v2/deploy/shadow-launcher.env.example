# Dedicated systemd EnvironmentFile for psy-v22-shadow@<instance>.service.
# Install as root:psy 0640 under /etc/psy/releases/<instance>/launcher.env.
# This file carries approval metadata only; it is not a shell script.
PSY_APPROVED_APP_VERSION=v2.2.0-shadow
PSY_APPROVED_RELEASE_ID=replace_with_approved_shadow_release_id
PSY_APPROVED_GIT_COMMIT=replace_with_approved_40_character_lowercase_commit
PSY_APPROVED_DATABASE_PATH=/var/lib/psy/databases/replace_instance/staged/yd_os-v22-shadow.db
# 5100 is the current deployment candidate, never the product default.
PSY_APPROVED_BIND_PORT=5100
