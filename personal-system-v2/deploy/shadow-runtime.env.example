# Descriptor-bound shadow runtime config. Install outside the code tree as
# root:psy 0640. The launcher rejects any database-path key here and injects
# the exact descriptor-bound staged database only after all release checks pass.
PERSONAL_OS_ENV=production
PERSONAL_OS_REMOTE=1
PERSONAL_OS_BIND_HOST=127.0.0.1
PERSONAL_OS_TRUSTED_HOSTS=shadow.example.com
PERSONAL_OS_TRUSTED_PROXY=127.0.0.1
PERSONAL_OS_PROXY_TOKEN=replace_with_a_distinct_shadow_csprng_token_of_at_least_32_bytes
SECRET_KEY=replace_with_a_shadow_csprng_secret_of_at_least_32_bytes
