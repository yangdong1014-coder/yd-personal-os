# 仅用于本机开发。生产不要复制或加载本文件；生产配置入口见 deploy/。
# DeepSeek API Key（未配置时仅 AI 功能不可用）
DEEPSEEK_API_KEY=your_key_here

# API 地址（可选，默认 https://api.deepseek.com/v1）
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 锁定 AI 模型（可选）
# DEEPSEEK_MODEL=deepseek-v4-pro

# 请求超时秒数（可选，默认 60）
# DEEPSEEK_TIMEOUT=60

# 本地开发 session 签名密钥（可选）；不要提交真实值。
# SECRET_KEY=replace-with-a-local-development-value

# 本文件只声明本机开发模式。
PERSONAL_OS_ENV=development

# 本地开发/测试如需覆盖数据库，只能指向临时或开发库；禁止指向真实
# personal-system-v2/data/yd_os.db。生产数据库路径不在本文件选择，而由
# release descriptor 绑定并由 production_launcher.py 注入。
# YD_OS_DB_PATH=C:\Temp\psy-v22-development.db

# 生产职责分离：
# - deploy/launcher.env.example：只提供批准的 app version / git commit 元数据
# - deploy/runtime.env.example：提供生产安全运行变量，禁止 YD_OS_DB_PATH
# - deploy/psy-v22.service：通过 production_launcher.py 启动正式链路
# 不要直接运行 production.py 或自行调用 Gunicorn 作为生产启动方式。

# 只控制正常本地开发是否后台运行，不能覆盖上述安全判断。
# PERSONAL_OS_BG=1
