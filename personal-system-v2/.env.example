# DeepSeek API Key（未配置时仅 AI 功能不可用）
DEEPSEEK_API_KEY=your_key_here

# API 地址（可选，默认 https://api.deepseek.com/v1）
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 锁定 AI 模型（可选）
# DEEPSEEK_MODEL=deepseek-v4-pro

# 请求超时秒数（可选，默认 60）
# DEEPSEEK_TIMEOUT=60

# Flask session 签名密钥。
# 除显式本地开发外都必须取消注释并替换为至少 32 字节强随机值；禁止提交真实密钥。
# SECRET_KEY=replace_with_a_strong_random_value

# 本机开发必须显式标记；其他值或缺失值默认按加固运行处理。
PERSONAL_OS_ENV=development
# 生产使用：PERSONAL_OS_ENV=production

# 任何远程可达运行（含 loopback 后的反向代理）都应启用；它不承担身份认证。
# 该信号会强制持久 SECRET_KEY、Secure cookie，并关闭 debug/reloader。
# PERSONAL_OS_REMOTE=1

# 默认 127.0.0.1；非 localhost 仅在 PERSONAL_OS_REMOTE=1 时允许。
# PERSONAL_OS_BIND_HOST=127.0.0.1

# 只控制正常本地开发是否后台运行，不能覆盖上述安全判断。
# PERSONAL_OS_BG=1
